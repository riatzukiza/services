# Caddy ingress environment contract.
#
# Placeholders only — this file is committed, the rendered .env is not.

CADDY_STATE_PATH='${OPEN_HAX_STATE_PATH}'
KNOXX_PUBLIC_HOST='knoxx.promethean.rest'
PROXX_PUBLIC_HOST='proxx.promethean.rest'
# The existing public Website alias. The complete hostname envelope and current
# exact-name certificate decision are in docs/caddy-hostname-certificate-decision.md.
# Verify its DNS and direct-origin challenge reachability before first issuance.
WEBSITE_PUBLIC_HOST='open-hax.promethean.rest'
# Where Let's Encrypt sends expiry warnings. Its own value rather than a reuse
# of KNOXX_API_KEY_USER_EMAIL, which now names a non-human service identity
# that nobody reads mail for. Held as a secret, not a variable: this repo is
# public and Actions prints non-secret vars verbatim into run logs.
CADDY_ACME_EMAIL='${CADDY_ACME_EMAIL}'

# ── Dev instances ───────────────────────────────────────────────────────────
#
# Hostnames for the host-resident development servers. Each needs an A record
# pointing at this droplet BEFORE the deploy that first carries its site block:
# Caddy uses its default HTTP-01/TLS-ALPN-01 challenges, and a missing DNS record
# fails issuance for itself. Per-site, so one missing record cannot take the
# other hostnames down.
#
# Recheck every name's A/AAAA records and ports 80/443 before enabling it; see
# docs/dev-instances.md §2. This template does not attest current DNS or issuance.
CADDY_KNOXX_DEV_HOST='knoxx-dev.promethean.rest'
CADDY_OPENCODE_DEV_HOST='opencode-dev.promethean.rest'
CADDY_SHADOW_DEV_HOST='shadow-dev.promethean.rest'

# Authentication for every dev vhost. One credential pair covers all three:
# they are the same trust boundary — host-level access to the production
# droplet — so separate credentials would imply a separation that does not
# exist.
#
# Generate the hash with:  docker run --rm caddy:2.8-alpine caddy hash-password
# Held as a secret: this repository is public, and a bcrypt hash of a weak
# password is not a secret in any useful sense.
DEV_BASIC_AUTH_USER='${DEV_BASIC_AUTH_USER}'
DEV_BASIC_AUTH_HASH='${DEV_BASIC_AUTH_HASH}'
